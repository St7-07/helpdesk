# Copy to `.env` and adjust. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://<user>@localhost:5432/helpdesk"
# Better Auth: secret is >= 32 chars (generate with `openssl rand -base64 32`);
# URL is where the browser reaches the app (the Vite dev server proxies /api).
BETTER_AUTH_SECRET="<random-32+-chars>"
BETTER_AUTH_URL="http://localhost:5173"
# First admin, created by `bun run db:seed`.
SEED_ADMIN_EMAIL="admin@hd.com"
SEED_ADMIN_PASSWORD="<admin-password>"
# Optional: database for server and e2e tests. Defaults to DATABASE_URL's
# database name + "_test"; it's created, migrated and emptied by the tests.
# TEST_DATABASE_URL="postgresql://<user>@localhost:5432/helpdesk_test"
