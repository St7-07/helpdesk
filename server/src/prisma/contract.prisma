// use prisma-8

// Better Auth core tables (email/password + database sessions).
// Column names follow Better Auth's defaults; ids are generated by Better Auth.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     TimestamptzJsDate @default(now())
  updatedAt     TimestamptzJsDate @default(now())
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt TimestamptzJsDate
  token     String   @unique
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzJsDate?
  refreshTokenExpiresAt TimestamptzJsDate?
  scope                 String?
  password              String?
  createdAt             TimestamptzJsDate @default(now())
  updatedAt             TimestamptzJsDate

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  TimestamptzJsDate
  createdAt  TimestamptzJsDate @default(now())
  updatedAt  TimestamptzJsDate @default(now())

  @@index([identifier])
  @@map("verification")
}
